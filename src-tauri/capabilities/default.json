{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Settings window",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    },
    "allow-app-info",
    "allow-get-settings",
    "allow-update-settings",
    "allow-set-shortcut",
    "allow-set-screenshot-shortcut",
    "allow-choose-save-folder",
    "allow-reset-save-folder",
    "allow-set-shortcut-paused",
    "allow-get-launch-at-login",
    "allow-set-launch-at-login",
    "allow-permission-status",
    "allow-request-permission",
    "allow-ocr-language-status",
    "allow-open-permission-settings",
    "allow-restart-app"
  ]
}
